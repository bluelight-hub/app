{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["./.oxlintrc.json"],
  "jsPlugins": [
    {
      "name": "repo-style",
      "specifier": "./tools/oxlint/repo-style-plugin.cjs"
    }
  ],
  "rules": {
    "repo-style/array-expression-multiline": ["error", { "minItems": 2 }]
  }
}
