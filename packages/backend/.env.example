# ==========================================
# BlueLight Hub Backend Environment Variables
# ADR-002 (Phase 1): Bootstrap + Infra + kontrollierte Overrides
# ==========================================

# ==== Bootstrap (Pflicht) ====
# PostgreSQL Verbindungsstring (ohne diesen Wert startet der Prozess nicht)
DATABASE_URL="postgresql://user:password@localhost:5432/bluelight_hub?schema=public"

# Root-Key für Secret-Entschlüsselung (einzige Pflicht-Secret-Variable)
# Erlaubte Formate:
# - 64 Hex-Zeichen (32 Bytes), empfohlen
# - Base64 mit 32 Byte Output
# - Passphrase (Kompatibilitätsmodus, intern per KDF abgeleitet)
MASTER_SECRET=replace-with-32-byte-hex-or-base64-key
# Beispiel (Hex, 32 Bytes):
# MASTER_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Legacy-Alias für Übergangsbetrieb: MASTER_SECRET_KEY

# ==== Infra (optional, bleibt ENV-basiert) ====
NODE_ENV=development
BACKEND_PORT=3091
PORT=3091

# Database Host-Port (docker-compose Mapping, default: 3092)
# In Worktrees automatisch via scripts/worktree-setup.sh gesetzt
DATABASE_PORT=3092
SERVER_NAME=Bluelight Hub

# Proxy / TLS
TRUSTED_PROXIES=
HTTPS_ENABLED=true
HTTPS_KEY_PATH=../../certs/localhost-key.pem
HTTPS_CERT_PATH=../../certs/localhost.pem

# Statischer Upload-Pfad
UPLOADS_PATH=../../uploads

# ==== Kontrollierte ENV-Overrides (Allowlist) ====
LOG_LEVEL=info
INSECURE_MODE=false
ERROR_HANDLING_ENABLE_ADVANCED_RETRY=true
ERROR_HANDLING_ENABLE_DUPLICATE_DETECTION=true
ERROR_HANDLING_ENABLE_METRICS=true
ERROR_HANDLING_ENABLE_CIRCUIT_BREAKER=true
ERROR_HANDLING_ENABLE_RATE_LIMITING=true

# ==== Legacy-/Migrations-Hinweise (DB-Primary Zielbild) ====
# Diese Keys werden nach ADR-002 schrittweise in app_config / app_config_secret geführt.
# Nur für Übergangsbetrieb behalten, nicht als langfristiges Ziel.
# Automatische Migration beim Boot: bekannte Runtime-ENV-Keys werden einmalig in die DB übernommen, sofern dort noch kein Wert liegt.

# Runtime URLs / CORS (DB-Primary)
# APP_URL=https://localhost:3091
# FRONTEND_URL=https://localhost:3090
# ALLOWED_ORIGINS=https://localhost:3090,https://localhost:3091
# ALLOWED_ORIGIN_PATTERNS=^https:\/\/[\w-]+\.bluelight-hub-app\.pages\.dev$

# Cache / Rate Limiting / Geocoding (DB-Primary)
# CACHE_TTL=60000
# CACHE_TTL_SECONDS=3600 # deprecated, wird auf CACHE_TTL gemappt
# CACHE_MAX_ITEMS=100
# CACHE_STORE=memory
# CACHE_IS_GLOBAL=true
# RATE_LIMITER_WINDOW_MS=60000
# RATE_LIMITER_MAX_REQUESTS=100
# NOMINATIM_API_URL=https://nominatim.openstreetmap.org
# NOMINATIM_RATE_LIMIT=1

# Auth / Integrations-Secrets (DB-Secret-Primary)
# JWT_SECRET=deprecated-moved-to-app_config_secret
# JWT_REFRESH_SECRET=deprecated-moved-to-app_config_secret
# ADMIN_JWT_SECRET=deprecated-moved-to-app_config_secret
# JWT_ACCESS_EXPIRES_IN=15m
# JWT_REFRESH_EXPIRES_IN=7d
# JWT_ADMIN_EXPIRES_IN=15m
# HIORG_OAUTH_CLIENT_ID=deprecated-moved-to-app_config
# HIORG_OAUTH_CLIENT_SECRET=deprecated-moved-to-app_config_secret

# Legacy Encryption Key (nur Dual-Read Übergangsphase)
# INTEGRATION_ENCRYPTION_KEY=deprecated-legacy-dual-read-only

# ==== Web-Push (Story 1.1, ADR-011) ====
# VAPID-Keypair für Plattform-Push-Notifications. Erzeugen via:
#   npx web-push generate-vapid-keys
# Public-Key ist nicht geheim und wird zusätzlich als VITE_VAPID_PUBLIC_KEY
# dem Frontend bekannt gemacht. Private-Key MUSS über @dotenvx/dotenvx
# (verschlüsselte .env.production) geladen werden — NIEMALS commiten.
# Ohne Public- UND Private-Key startet das PushNotificationsModule nicht
# (Fail-Fast in OnModuleInit).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@example.org
