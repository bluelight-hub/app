{
  "name": "@bluelight-hub/shared",
  "version": "1.0.0-alpha.31",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./client/index.ts",
      "import": "./client/index.ts"
    }
  },
  "scripts": {
    "lint": "biome check --write",
    "lint:check": "biome check",
    "generate-api": "rimraf client && openapi-generator-cli generate -g=typescript-fetch -i http://localhost:3000/api-json -o ./client --skip-validate-spec && pnpm lint",
    "build:tsc": "tsc",
    "build": "pnpm build:tsc",
    "build:with-api": "pnpm generate-api && pnpm build:tsc",
    "build:ci": "echo 'Skipping API generation in CI - using pre-generated clients'",
    "test": "echo 'No tests available for shared package'"
  },
  "devDependencies": {
    "@openapitools/openapi-generator-cli": "^2.21.4",
    "@types/zxcvbn": "^4.4.5",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "zxcvbn": "^4.4.2"
  }
}
