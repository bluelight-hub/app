# API Configuration
# Standard mit den lokalen Zertifikaten aus `pnpm run gen:certs`
VITE_API_URL=https://localhost:3091

# Für HTTP-only lokal stattdessen:
# VITE_API_URL=http://localhost:3091

# Security Mode
# Wenn 'true', sind http:// Verbindungen erlaubt (nur für Entwicklung!)
# In Produktion sollte dies NIEMALS gesetzt sein.
# VITE_INSECURE_MODE=true
