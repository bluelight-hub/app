{
  "name": "bluelight-hub",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm -r --filter '@bluelight-hub/*' dev",
    "gen:certs": "./scripts/generate-certs.sh",
    "build": "pnpm -r --filter '@bluelight-hub/*' build",
    "generate-api": "pnpm -r --filter '@bluelight-hub/*' --if-present generate-api",
    "lint": "biome check --write",
    "lint:check": "biome check",
    "test": "pnpm -r --filter '@bluelight-hub/*' test",
    "test:ui": "pnpm -r --filter '@bluelight-hub/*' test:ui",
    "test:cov": "pnpm -r --filter '@bluelight-hub/*' test:cov",
    "prepare": "command -v husky >/dev/null 2>&1 && husky || echo 'husky not available, skipping git hooks setup'"
  },
  "packageManager": "pnpm@10.28.0+sha512.05df71d1421f21399e053fde567cea34d446fa02c76571441bfc1c7956e98e363088982d940465fd34480d4d90a0668bc12362f8aa88000a64e83d0b0e47be48",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@compodoc/compodoc",
      "@nestjs/core",
      "@openapitools/openapi-generator-cli",
      "@playwright/browser-chromium",
      "@prisma/client",
      "@prisma/engines",
      "@scarf/scarf",
      "@swc/core",
      "@tailwindcss/oxide",
      "bcrypt",
      "es5-ext",
      "esbuild",
      "prisma",
      "puppeteer",
      "unix-dgram",
      "unrs-resolver"
    ],
    "overrides": {
      "mermaid": ">=11.10.0",
      "glob": ">=11.1.0"
    }
  },
  "lint-staged": {
    "**/*.{js,ts,tsx,json,md,yml,yaml}": ["biome check --write --no-errors-on-unmatched"],
    "packages/backend/**/*.ts": ["pnpm --filter @bluelight-hub/backend lint"],
    "packages/backend/src/domain/**/*.ts": ["pnpm --filter @bluelight-hub/backend lint:domain"],
    "packages/frontend/**/*.{ts,tsx}": ["pnpm --filter @bluelight-hub/frontend lint"]
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.15",
    "@mermaid-js/mermaid-cli": "^11.12.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.6",
    "@softwaretechnik/dbml-renderer": "^1.0.31",
    "debug": "^4.4.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "puppeteer": "^24.37.2",
    "semantic-release": "^25.0.3",
    "semantic-release-gitmoji": "^1.6.9"
  }
}
