{
  "name": "bluelight-hub",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm -r --filter '@bluelight-hub/*' dev",
    "dev:web": "pnpm --filter @bluelight-hub/backend dev & pnpm --filter @bluelight-hub/frontend dev:vite & wait",
    "gen:certs": "./scripts/generate-certs.sh",
    "check:repo-hygiene": "bash ./scripts/check-repo-hygiene.sh",
    "gitmoji:sync": "node scripts/sync-gitmojis.mjs --write",
    "gitmoji:check": "node scripts/sync-gitmojis.mjs --check",
    "commit:check-range": "node scripts/check-commit-range.mjs",
    "build": "pnpm -r --filter '@bluelight-hub/*' build",
    "generate-api": "pnpm -r --filter '@bluelight-hub/*' --if-present generate-api",
    "lint": "oxlint --fix && oxfmt --write .",
    "lint:check": "oxlint && oxfmt --check .",
    "test": "pnpm -r --filter '@bluelight-hub/*' test",
    "test:gitmoji": "node --test scripts/__tests__/gitmoji-commit-validator.test.mjs",
    "test:ui": "pnpm -r --filter '@bluelight-hub/*' test:ui",
    "test:cov": "pnpm -r --filter '@bluelight-hub/*' test:cov",
    "prepare": "command -v husky >/dev/null 2>&1 && husky || echo 'husky not available, skipping git hooks setup'"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.6",
    "debug": "^4.4.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "oxfmt": "^0.45.0",
    "oxlint": "^1.60.0",
    "semantic-release": "^25.0.3",
    "semantic-release-claude-changelog": "^2.0.0",
    "semantic-release-gitmoji": "^1.6.9"
  },
  "lint-staged": {
    "**/*.{js,ts,tsx}": [
      "oxlint --fix",
      "oxfmt --write --no-error-on-unmatched-pattern"
    ],
    "**/*.{json,yml,yaml}": [
      "oxfmt --write --no-error-on-unmatched-pattern"
    ],
    "**/*.md": [
      "oxfmt --write --no-error-on-unmatched-pattern"
    ]
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.32.1+sha512.a706938f0e89ac1456b6563eab4edf1d1faf3368d1191fc5c59790e96dc918e4456ab2e67d613de1043d2e8c81f87303e6b40d4ffeca9df15ef1ad567348f2be",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@compodoc/compodoc",
      "@nestjs/core",
      "@openapitools/openapi-generator-cli",
      "@playwright/browser-chromium",
      "@prisma/client",
      "@prisma/engines",
      "@scarf/scarf",
      "@swc/core",
      "@tailwindcss/oxide",
      "bcrypt",
      "es5-ext",
      "esbuild",
      "prisma",
      "unix-dgram",
      "unrs-resolver"
    ],
    "overrides": {
      "glob": ">=11.1.0",
      "handlebars": ">=4.7.9",
      "lodash": ">=4.18.0",
      "lodash-es": ">=4.18.0",
      "undici@<7": ">=6.24.0",
      "undici@>=7": ">=7.24.0",
      "seroval": ">=1.4.1",
      "fast-xml-parser": ">=5.5.7",
      "minimatch@<10": ">=9.0.7",
      "minimatch@>=10": ">=10.2.3",
      "@isaacs/brace-expansion": ">=5.0.1",
      "brace-expansion": ">=2.0.3",
      "picomatch": ">=4.0.4",
      "yaml": ">=2.8.3",
      "qs": ">=6.14.2",
      "diff": ">=4.0.4",
      "ajv": ">=8.18.0",
      "socket.io-parser": ">=4.2.6",
      "@hono/node-server": ">=1.19.13",
      "follow-redirects": ">=1.16.0"
    }
  }
}
