{
  "name": "bluelight-hub",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm -r --filter '@bluelight-hub/*' dev",
    "build": "pnpm -r --filter '@bluelight-hub/*' build",
    "generate-api": "pnpm -r --filter '@bluelight-hub/*' --if-present generate-api",
    "lint": "biome check --write",
    "lint:check": "biome check && pnpm -r --filter '@bluelight-hub/*' lint:check",
    "test": "pnpm -r --filter '@bluelight-hub/*' test",
    "test:ui": "pnpm -r --filter '@bluelight-hub/*' test:ui",
    "test:cov": "pnpm -r --filter '@bluelight-hub/*' test:cov",
    "docs:html": "asciidoctor -r asciidoctor-diagram -a mmdc=./mmdc-no-sandbox docs/index.adoc -o dist/docs/index.html",
    "docs:pdf": "asciidoctor-pdf -r asciidoctor-diagram -a mmdc=./mmdc-no-sandbox -s docs/styles/bluelight-pdf.css docs/index.adoc -o dist/docs/bluelight-hub-architecture.pdf",
    "docs:build": "mkdir -p dist/docs && pnpm docs:html && pnpm docs:pdf",
    "docs:deploy": "pnpm docs:build",
    "prepare": "command -v husky >/dev/null 2>&1 && husky || echo 'husky not available, skipping git hooks setup'",
    "bmad:refresh": "bmad-method install -f -i codex",
    "bmad:list": "bmad-method list:agents",
    "bmad:validate": "bmad-method validate"
  },
  "packageManager": "pnpm@10.17.1+sha512.17c560fca4867ae9473a3899ad84a88334914f379be46d455cbf92e5cf4b39d34985d452d2583baf19967fa76cb5c17bc9e245529d0b98745721aa7200ecaf7a",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@compodoc/compodoc",
      "@nestjs/core",
      "@openapitools/openapi-generator-cli",
      "@prisma/client",
      "@prisma/engines",
      "@scarf/scarf",
      "@swc/core",
      "@tailwindcss/oxide",
      "bcrypt",
      "es5-ext",
      "esbuild",
      "prisma",
      "puppeteer",
      "unrs-resolver"
    ]
  },
  "lint-staged": {
    "**/*.{js,ts,tsx,json,md,yml,yaml}": ["biome check --write"],
    "packages/backend/**/*.ts": ["pnpm --filter @bluelight-hub/backend lint"],
    "packages/frontend/**/*.{ts,tsx}": ["pnpm --filter @bluelight-hub/frontend lint"]
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.2",
    "@mermaid-js/mermaid-cli": "^11.9.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.3",
    "@softwaretechnik/dbml-renderer": "^1.0.31",
    "debug": "^4.4.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "puppeteer": "^24.15.0",
    "semantic-release": "^24.2.7",
    "semantic-release-gitmoji": "^1.6.8"
  }
}
