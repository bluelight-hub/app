{
  "name": "bluelight-hub",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm -r dev",
    "build": "pnpm -r build",
    "generate-api": "pnpm -r generate-api",
    "lint": "biome check --write",
    "lint:check": "biome check && pnpm -r lint:check",
    "test": "pnpm -r test",
    "test:ui": "pnpm -r test:ui",
    "test:cov": "pnpm -r test:cov",
    "docs:html": "asciidoctor -r asciidoctor-diagram -a mmdc=./mmdc-no-sandbox docs/index.adoc -o dist/docs/index.html",
    "docs:pdf": "asciidoctor-pdf -r asciidoctor-diagram -a mmdc=./mmdc-no-sandbox -s docs/styles/bluelight-pdf.css docs/index.adoc -o dist/docs/bluelight-hub-architecture.pdf",
    "docs:build": "mkdir -p dist/docs && pnpm docs:html && pnpm docs:pdf",
    "docs:deploy": "pnpm docs:build",
    "prepare": "command -v husky >/dev/null 2>&1 && husky || echo 'husky not available, skipping git hooks setup'",
    "bmad:refresh": "bmad-method install -f -i codex",
    "bmad:list": "bmad-method list:agents",
    "bmad:validate": "bmad-method validate"
  },
  "packageManager": "pnpm@10.15.1+sha512.34e538c329b5553014ca8e8f4535997f96180a1d0f614339357449935350d924e22f8614682191264ec33d1462ac21561aff97f6bb18065351c162c7e8f6de67",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@compodoc/compodoc",
      "@nestjs/core",
      "@openapitools/openapi-generator-cli",
      "@prisma/client",
      "@prisma/engines",
      "@scarf/scarf",
      "@swc/core",
      "@tailwindcss/oxide",
      "bcrypt",
      "es5-ext",
      "esbuild",
      "prisma",
      "puppeteer",
      "unrs-resolver"
    ]
  },
  "lint-staged": {
    "**/*.{js,ts,tsx,json,md,yml,yaml}": ["biome check --write"],
    "packages/backend/**/*.ts": ["pnpm --filter @bluelight-hub/backend lint"],
    "packages/frontend/**/*.{ts,tsx}": ["pnpm --filter @bluelight-hub/frontend lint"]
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.2",
    "@mermaid-js/mermaid-cli": "^11.9.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.3",
    "@softwaretechnik/dbml-renderer": "^1.0.31",
    "bpmn-js-cmd": "^0.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "puppeteer": "^24.15.0",
    "semantic-release": "^24.2.7",
    "semantic-release-gitmoji": "^1.6.8"
  }
}
