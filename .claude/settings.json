{
  "enabledPlugins": {},
  "permissions": {
    "allow": [
      "Bash(pnpm exec tsc --noEmit *)",
      "Bash(pnpm --filter @bluelight-hub/backend check:arch)",
      "Bash(pnpm --filter @bluelight-hub/backend check:di:imports)",
      "Bash(pnpm --filter @bluelight-hub/shared:*)",
      "Bash(docker compose ps *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/lint-on-edit.sh"
          }
        ]
      }
    ]
  }
}
